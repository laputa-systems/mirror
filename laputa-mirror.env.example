LISTEN_ADDR=127.0.0.1:3000

# Cloudflare R2 (S3-compatible)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=laputa-mirror
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Public R2 URL. Omit this for a tunnel-only public surface.
# R2_PUBLIC_URL=https://pub-HASH.r2.dev

# Passkey auth
DB_PATH=/var/lib/laputa-mirror/auth.db
ALLOWED_USERS=josh
RP_ID=laputa.17166969.xyz
RP_ORIGIN=https://laputa.17166969.xyz

# JWT/OIDC for CI. Omit to disable.
JWT_JWKS_URL=https://token.actions.githubusercontent.com/.well-known/jwks
JWT_ISSUER=https://token.actions.githubusercontent.com
JWT_AUDIENCE=laputa-mirror
JWT_SUBJECT_PATTERN=repo:josh/*
